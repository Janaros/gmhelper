<UserControl x:Class="GMHelper.App.Views.StatFieldEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GMHelper.App"
             x:Name="Root"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ItemsControl Grid.Row="0" ItemsSource="{Binding ItemsSource, ElementName=Root}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsLocked}" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="{Binding ValueMaxLength}" Margin="0,0,6,0" />
                        <Button Grid.Column="2" Content="↑" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0"
                                Click="MoveUpButton_Click" Tag="{Binding}" />
                        <Button Grid.Column="3" Content="↓" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0"
                                Click="MoveDownButton_Click" Tag="{Binding}" />
                        <Button Grid.Column="4" Content="✕" Style="{StaticResource IconButtonStyle}"
                                Click="RemoveButton_Click" Tag="{Binding}"
                                Visibility="{Binding IsLocked, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Row="1" Content="Feld hinzufügen" HorizontalAlignment="Left" Margin="0,8,0,0" Click="AddButton_Click" />
    </Grid>
</UserControl>
