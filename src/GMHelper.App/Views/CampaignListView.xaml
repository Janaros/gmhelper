<UserControl x:Class="GMHelper.App.Views.CampaignListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GMHelper.App"
             mc:Ignorable="d">
    <Grid Margin="{StaticResource ViewMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
            <TextBox Width="240" Text="{Binding NewCampaignName, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Kampagne anlegen" Margin="8,0,0,0" Command="{Binding AddCampaignCommand}" />
            <Button Content="Öffnen" Margin="8,0,0,0" Command="{Binding OpenSelectedCampaignCommand}" />
            <Button Content="Ausgewählte löschen" Margin="8,0,0,0" Command="{Binding DeleteCampaignCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource StatusTextStyle}"
                   Visibility="{Binding StatusMessage, Converter={x:Static local:NullToVisibilityConverter.Instance}}" />

        <Grid Grid.Row="2">
            <Image Source="/Assets/GMHelper-background.png"
                   Opacity="0.06"
                   Stretch="Uniform"
                   Width="480"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False" />

            <ListBox ItemsSource="{Binding Campaigns}"
                     SelectedItem="{Binding SelectedCampaign}"
                     DisplayMemberPath="Name"
                     Background="Transparent">
                <ListBox.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenSelectedCampaignCommand}" />
                </ListBox.InputBindings>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
