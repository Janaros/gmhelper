<UserControl x:Class="GMHelper.App.Views.CombatTrackerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GMHelper.App"
             xmlns:syncfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
             mc:Ignorable="d">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CurrentTurnBrush" Color="#FFEFD98A" />
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Kampf vorbereiten"
                    Command="{Binding PrepareEncounterCommand}"
                    Visibility="{Binding HasActiveEncounter, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}" />

            <Button Content="Kampf beginnen"
                    Command="{Binding StartEncounterCommand}"
                    Visibility="{Binding IsPreparing, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />

            <TextBlock Text="{Binding CurrentRound, StringFormat='Runde {0}'}"
                       VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,12,0"
                       Visibility="{Binding HasStarted, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
            <Button Content="Nächster"
                    Command="{Binding NextTurnCommand}"
                    Visibility="{Binding HasStarted, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />

            <Button Content="Kampf beenden"
                    Command="{Binding EndEncounterCommand}"
                    Margin="16,0,0,0"
                    Visibility="{Binding HasActiveEncounter, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8"
                    Visibility="{Binding HasActiveEncounter, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <ComboBox Width="220" ItemsSource="{Binding AvailableMonsters}" SelectedItem="{Binding SelectedMonsterToAdd}" DisplayMemberPath="Name" />
            <Button Content="Monster hinzufügen" Margin="8,0,0,0" Command="{Binding AddMonsterCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="{Binding StatusMessage, Converter={x:Static local:NullToVisibilityConverter.Instance}}" />

        <syncfusion:SfDataGrid Grid.Row="3"
                                ItemsSource="{Binding Participants}"
                                AutoGenerateColumns="False"
                                AllowEditing="False"
                                AllowSorting="False"
                                AllowResizingColumns="True"
                                HeaderRowHeight="32"
                                RowHeight="44">
            <syncfusion:SfDataGrid.RowStyle>
                <Style TargetType="syncfusion:VirtualizingCellsControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCurrentTurn}" Value="True">
                            <Setter Property="Background" Value="{StaticResource CurrentTurnBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </syncfusion:SfDataGrid.RowStyle>
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTemplateColumn MappingName="DisplayName" HeaderText="Name" Width="150">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding DisplayName}"
                                     IsReadOnly="{Binding IsMonster, Converter={x:Static local:InverseBoolConverter.Instance}}"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Margin="6,0" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridTemplateColumn MappingName="InitiativeText" HeaderText="Initiative" Width="120">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                <TextBox Text="{Binding InitiativeText}" Width="40" BorderThickness="0" Background="Transparent" />
                                <Button Content="🎲" Width="28" Margin="4,0,0,0" Click="RollInitiativeButton_Click" Tag="{Binding}" ToolTip="W20 würfeln" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridTemplateColumn MappingName="TrackedValueText" HeaderText="HP" Width="170">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                <Button Content="−" Width="24" Click="DecrementHpButton_Click" Tag="{Binding}" />
                                <TextBox Text="{Binding TrackedValueText}" Width="40" Margin="2,0" BorderThickness="0" Background="Transparent" />
                                <Button Content="+" Width="24" Click="IncrementHpButton_Click" Tag="{Binding}" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding MaxTrackedValue, StringFormat='/ {0}'}"
                                           Visibility="{Binding MaxTrackedValue, Converter={x:Static local:NullToVisibilityConverter.Instance}}" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridTemplateColumn MappingName="ConditionsText" HeaderText="Zustände" Width="220">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding ConditionsText}"
                                     ToolTip="Zustände (frei, z.B. vergiftet)"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Margin="6,0" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridTemplateColumn MappingName="Id" HeaderText="" Width="50" AllowResizing="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✕" Width="24" Click="RemoveParticipantButton_Click" Tag="{Binding}" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
    </Grid>
</UserControl>
