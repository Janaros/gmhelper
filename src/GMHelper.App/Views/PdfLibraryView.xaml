<UserControl x:Class="GMHelper.App.Views.PdfLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GMHelper.App"
             xmlns:syncfusion="clr-namespace:Syncfusion.Windows.PdfViewer;assembly=Syncfusion.PdfViewer.WPF"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="PdfTabStripStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,6" />
                        <Setter Property="Margin" Value="0,0,2,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource AppBorderBrush}"
                                            BorderThickness="1,1,1,0"
                                            CornerRadius="4,4,0,0"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="White" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#FF999999" BorderThickness="1" CornerRadius="2">
                            <Border x:Name="Sel" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="2" Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Sel" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource SubViewMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Content="PDF hinzufügen" Margin="0,0,8,0" Click="AddPdfButton_Click" />
            <Button DockPanel.Dock="Left" Content="PDF entfernen" Margin="0,0,8,0" Command="{Binding DeleteSelectedPdfCommand}" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ListBox x:Name="PdfList"
                         Style="{StaticResource PdfTabStripStyle}"
                         ItemsSource="{Binding Pdfs}"
                         SelectedItem="{Binding SelectedPdf}"
                         DisplayMemberPath="FileName" />
            </ScrollViewer>
        </DockPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource StatusTextStyle}"
                   Margin="0,0,0,8"
                   Visibility="{Binding StatusMessage, Converter={x:Static local:NullToVisibilityConverter.Instance}}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <ToggleButton x:Name="ToggleInkButton" Content="✏ Stift" Click="ToggleInkButton_Click" />
            <ToggleButton x:Name="ToggleFreeTextButton" Content="🔤 Block hinzufügen" Click="ToggleFreeTextButton_Click" Margin="8,0,0,0" />
            <ToggleButton x:Name="ToggleRedactButton" Content="⛔ Text ersetzen" Click="ToggleRedactButton_Click" Margin="8,0,0,0" />
            <Button Content="Speichern" Margin="16,0,0,0" Click="SaveButton_Click" />
            <Button Content="Inhaltsverzeichnis erzeugen" Margin="8,0,0,0" Click="GenerateTocButton_Click"
                    ToolTip="Scannt das PDF nach nummerierten Überschriften und legt echte PDF-Lesezeichen an" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8"
                    Visibility="{Binding IsChecked, ElementName=ToggleInkButton, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <TextBlock Text="Farbe:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <RadioButton x:Name="ColorRed" GroupName="InkColor" Style="{StaticResource ColorSwatchStyle}" Background="Red" Click="InkColor_Click" />
            <RadioButton x:Name="ColorGreen" GroupName="InkColor" Style="{StaticResource ColorSwatchStyle}" Background="Green" Click="InkColor_Click" />
            <RadioButton x:Name="ColorBlack" GroupName="InkColor" Style="{StaticResource ColorSwatchStyle}" Background="Black" Click="InkColor_Click" IsChecked="True" />
            <RadioButton x:Name="ColorYellow" GroupName="InkColor" Style="{StaticResource ColorSwatchStyle}" Background="Gold" Click="InkColor_Click" />

            <TextBlock Text="Dicke:" VerticalAlignment="Center" Margin="16,0,8,0" />
            <RadioButton GroupName="InkThickness" Content="Dünn" Tag="1" Click="InkThickness_Click" VerticalContentAlignment="Center" Margin="0,0,8,0" />
            <RadioButton GroupName="InkThickness" Content="Normal" Tag="3" Click="InkThickness_Click" IsChecked="True" VerticalContentAlignment="Center" Margin="0,0,8,0" />
            <RadioButton GroupName="InkThickness" Content="Dick" Tag="6" Click="InkThickness_Click" VerticalContentAlignment="Center" />

            <CheckBox x:Name="TransparentCheckBox"
                      Content="Transparent (markieren)"
                      VerticalAlignment="Center"
                      Margin="16,0,0,0"
                      Checked="TransparentCheckBox_Changed"
                      Unchecked="TransparentCheckBox_Changed" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8"
                    Visibility="{Binding IsChecked, ElementName=ToggleFreeTextButton, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <TextBlock Text="Schriftfarbe:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <RadioButton x:Name="FreeTextColorBlack" GroupName="FreeTextColor" Style="{StaticResource ColorSwatchStyle}" Background="Black" Click="FreeTextColor_Click" IsChecked="True" />
            <RadioButton x:Name="FreeTextColorRed" GroupName="FreeTextColor" Style="{StaticResource ColorSwatchStyle}" Background="Red" Click="FreeTextColor_Click" />
            <RadioButton x:Name="FreeTextColorBlue" GroupName="FreeTextColor" Style="{StaticResource ColorSwatchStyle}" Background="Blue" Click="FreeTextColor_Click" />

            <TextBlock Text="Größe:" VerticalAlignment="Center" Margin="16,0,8,0" />
            <RadioButton GroupName="FreeTextSize" Content="Klein" Tag="10" Click="FreeTextSize_Click" VerticalContentAlignment="Center" Margin="0,0,8,0" />
            <RadioButton GroupName="FreeTextSize" Content="Normal" Tag="14" Click="FreeTextSize_Click" IsChecked="True" VerticalContentAlignment="Center" Margin="0,0,8,0" />
            <RadioButton GroupName="FreeTextSize" Content="Groß" Tag="20" Click="FreeTextSize_Click" VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8"
                    Visibility="{Binding IsChecked, ElementName=ToggleRedactButton, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <TextBlock Text="Neuer Text:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="RedactOverlayTextBox" Width="220" TextChanged="RedactOverlayTextBox_TextChanged" />

            <TextBlock Text="Farbe:" VerticalAlignment="Center" Margin="16,0,8,0" />
            <RadioButton x:Name="RedactColorBlack" GroupName="RedactColor" Style="{StaticResource ColorSwatchStyle}" Background="Black" Click="RedactColor_Click" IsChecked="True" />
            <RadioButton x:Name="RedactColorRed" GroupName="RedactColor" Style="{StaticResource ColorSwatchStyle}" Background="Red" Click="RedactColor_Click" />

            <Button Content="Anwenden" Margin="16,0,0,0" Click="ApplyRedactionButton_Click" />
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="JumpMarkersColumn" Width="220" />
            </Grid.ColumnDefinitions>

            <syncfusion:PdfViewerControl x:Name="PdfViewer" Grid.Column="0" />

            <Button x:Name="ToggleJumpMarkersPanelButton" Grid.Column="1" Content="»"
                    Style="{StaticResource IconButtonStyle}" MinWidth="20" Margin="4,0"
                    Click="ToggleJumpMarkersPanelButton_Click"
                    ToolTip="Sprungmarken-Panel ein-/ausblenden" />

            <Grid x:Name="JumpMarkersPanel" Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Sprungmarken" Style="{StaticResource SectionHeaderTextStyle}" />

                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="+ Hier" Margin="8,0,0,0" Click="AddJumpMarkerButton_Click" />
                    <TextBox x:Name="NewJumpMarkerTitleTextBox" ToolTip="Name der Sprungmarke für die aktuell offene Seite" />
                </DockPanel>

                <ListBox Grid.Row="2" ItemsSource="{Binding JumpMarkers}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" HorizontalContentAlignment="Left" Padding="8,5" Click="JumpMarkerButton_Click" Tag="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PageNumber, StringFormat=' (S. {0})'}" Opacity="0.6" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Content="✕" Style="{StaticResource IconButtonStyle}" Margin="4,0,0,0"
                                        Click="RemoveJumpMarkerButton_Click" Tag="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
