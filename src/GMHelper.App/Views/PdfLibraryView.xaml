<UserControl x:Class="GMHelper.App.Views.PdfLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GMHelper.App"
             xmlns:syncfusion="clr-namespace:Syncfusion.Windows.PdfViewer;assembly=Syncfusion.PdfViewer.WPF"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="PdfTabStripStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,6" />
                        <Setter Property="Margin" Value="0,0,2,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="#FFF0F0F0"
                                            BorderBrush="#FFDDDDDD"
                                            BorderThickness="1,1,1,0"
                                            CornerRadius="4,4,0,0"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="White" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3F87DA" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFE8EEF5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#FF999999" BorderThickness="1" CornerRadius="2">
                            <Border x:Name="Sel" BorderBrush="#FF3F87DA" BorderThickness="2" CornerRadius="2" Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Sel" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <Button DockPanel.Dock="Left" Content="PDF hinzufügen" Margin="0,0,8,0" Click="AddPdfButton_Click" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ListBox x:Name="PdfList"
                         Style="{StaticResource PdfTabStripStyle}"
                         ItemsSource="{Binding Pdfs}"
                         SelectedItem="{Binding SelectedPdf}"
                         DisplayMemberPath="FileName" />
            </ScrollViewer>
        </DockPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4"
                   Visibility="{Binding StatusMessage, Converter={x:Static local:NullToVisibilityConverter.Instance}}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
            <ToggleButton x:Name="ToggleInkButton" Content="✏ Stift" Click="ToggleInkButton_Click" Padding="8,4" />
            <Button Content="Speichern" Margin="8,0,0,0" Click="SaveButton_Click" Padding="8,4" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4"
                    Visibility="{Binding IsChecked, ElementName=ToggleInkButton, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <TextBlock Text="Farbe:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <RadioButton x:Name="ColorRed" GroupName="InkColor" Style="{StaticResource ColorSwatchStyle}" Background="Red" Click="InkColor_Click" />
            <RadioButton x:Name="ColorGreen" GroupName="InkColor" Style="{StaticResource ColorSwatchStyle}" Background="Green" Click="InkColor_Click" />
            <RadioButton x:Name="ColorBlack" GroupName="InkColor" Style="{StaticResource ColorSwatchStyle}" Background="Black" Click="InkColor_Click" IsChecked="True" />
            <RadioButton x:Name="ColorYellow" GroupName="InkColor" Style="{StaticResource ColorSwatchStyle}" Background="Gold" Click="InkColor_Click" />

            <TextBlock Text="Dicke:" VerticalAlignment="Center" Margin="16,0,4,0" />
            <RadioButton GroupName="InkThickness" Content="Dünn" Tag="1" Click="InkThickness_Click" VerticalContentAlignment="Center" Margin="0,0,8,0" />
            <RadioButton GroupName="InkThickness" Content="Normal" Tag="3" Click="InkThickness_Click" IsChecked="True" VerticalContentAlignment="Center" Margin="0,0,8,0" />
            <RadioButton GroupName="InkThickness" Content="Dick" Tag="6" Click="InkThickness_Click" VerticalContentAlignment="Center" />

            <CheckBox x:Name="TransparentCheckBox"
                      Content="Transparent (markieren)"
                      VerticalAlignment="Center"
                      Margin="16,0,0,0"
                      Checked="TransparentCheckBox_Changed"
                      Unchecked="TransparentCheckBox_Changed" />
        </StackPanel>

        <syncfusion:PdfViewerControl x:Name="PdfViewer" Grid.Row="4" />
    </Grid>
</UserControl>
