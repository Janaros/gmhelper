<Window x:Class="GMHelper.App.Views.SecondaryDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:GMHelper.App"
        mc:Ignorable="d"
        Title="GMHelper – Spieleransicht"
        Icon="/Assets/GMHelper.ico"
        Background="Black"
        WindowStartupLocation="Manual"
        Width="1024" Height="768">
    <Grid>
        <Image Source="{Binding ImagePath, Converter={x:Static local:FilePathToBitmapImageConverter.Instance}}"
               Stretch="Uniform" />

        <Border Background="Black"
                Visibility="{Binding IsBlackedOut, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
    </Grid>
</Window>
