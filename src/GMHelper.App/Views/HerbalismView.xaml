<UserControl x:Class="GMHelper.App.Views.HerbalismView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GMHelper.App"
             xmlns:syncfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
             mc:Ignorable="d">
    <Grid Margin="{StaticResource ViewMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,16">
            <Button Content="&lt; Zurück" Command="{Binding BackCommand}" />
            <TextBlock Text="🌿 Kräuterkunde" Style="{StaticResource PageTitleTextStyle}" Margin="12,0,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource StatusTextStyle}"
                   Visibility="{Binding StatusMessage, Converter={x:Static local:NullToVisibilityConverter.Instance}}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Gebiete -->
            <Grid Grid.Column="0" Margin="{StaticResource GutterMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Gebiet" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Content="+ Neu" Command="{Binding NewRegionCommand}" Margin="8,0,0,0" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Regions}"
                         SelectedItem="{Binding SelectedRegion}"
                         Margin="0,0,0,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource HintTextStyle}">
                                    <Run Text="{Binding Terrain, Mode=OneWay}" />
                                    <Run Text=" · SG " />
                                    <Run Text="{Binding DifficultyClass, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Gebiet bearbeiten" Style="{StaticResource SectionHeaderTextStyle}" />

                        <TextBlock Text="Name" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding EditRegionName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                        <TextBlock Text="Gelände" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding EditRegionTerrain, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                        <TextBlock Text="SG des Sammelwurfs (10 ergiebig / 15 normal / 20 karg)" Style="{StaticResource HintTextStyle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding EditRegionDifficultyClassText, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalAlignment="Left" Margin="0,0,0,8" />

                        <TextBlock Text="Beschreibung" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding EditRegionDescription, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="56" Margin="{StaticResource FieldMargin}" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Speichern" Command="{Binding SaveRegionCommand}" />
                            <Button Content="Löschen" Command="{Binding DeleteRegionCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Fundtabelle -->
            <Grid Grid.Column="1" Margin="{StaticResource GutterMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Suche" VerticalAlignment="Center" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="8,0,0,0" />
                    <ComboBox ItemsSource="{Binding KindFilterOptions}"
                              SelectedItem="{Binding SelectedKindFilter}"
                              DisplayMemberPath="Label"
                              Width="170"
                              Margin="12,0,0,0" />
                    <Button Content="+ Zutat" Command="{Binding NewIngredientCommand}" Margin="12,0,0,0" />
                </StackPanel>

                <syncfusion:SfDataGrid Grid.Row="1"
                                       ItemsSource="{Binding Ingredients}"
                                       SelectedItem="{Binding SelectedIngredient, Mode=TwoWay}"
                                       SelectionMode="Single"
                                       AutoGenerateColumns="False"
                                       AllowEditing="False"
                                       AllowSorting="True"
                                       AllowResizingColumns="True"
                                       HeaderRowHeight="32"
                                       RowHeight="32"
                                       Margin="0,0,0,12">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="Name" HeaderText="Zutat" Width="180" />
                        <syncfusion:GridTextColumn MappingName="KindLabel" HeaderText="Art" Width="110" />
                        <syncfusion:GridTextColumn MappingName="RarityLabel" HeaderText="Seltenheit" Width="110" />
                        <syncfusion:GridTextColumn MappingName="ValueLabel" HeaderText="Wert" Width="80" />
                        <!-- Einzige Star-Spalte: nimmt die Restbreite ein, die vier festen Spalten davor behalten ihre Breite. -->
                        <syncfusion:GridTextColumn MappingName="Effect" HeaderText="Wirkung / Verwendung" ColumnSizer="Star" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Zutat bearbeiten" Style="{StaticResource SectionHeaderTextStyle}" />

                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Name" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding EditIngredientName, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Art" Style="{StaticResource FieldLabelTextStyle}" />
                                <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding EditIngredientKind}" DisplayMemberPath="Label" Width="130" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Seltenheit" Style="{StaticResource FieldLabelTextStyle}" />
                                <ComboBox ItemsSource="{Binding RarityOptions}" SelectedItem="{Binding EditIngredientRarity}" DisplayMemberPath="Label" Width="130" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Wert (GM)" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding EditIngredientValueText, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Wirkung / Verwendung" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{Binding EditIngredientEffect, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="48" Margin="0,0,0,8" />
                            <TextBlock Text="Notizen" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{Binding EditIngredientNotes, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="40" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0">
                            <Button Content="Speichern" Command="{Binding SaveIngredientCommand}" Margin="0,0,0,8" />
                            <Button Content="Löschen" Command="{Binding DeleteIngredientCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Sammelwurf -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Background="{StaticResource SurfaceAltBrush}">
                <Grid DataContext="{Binding Harvest}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Sammeln" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                        <TextBlock Text="Weisheit (Überleben) gegen den SG des Gebiets. Je 5 Punkte über dem SG gibt es eine Zutat mehr und schaltet seltenere frei."
                                   Style="{StaticResource HintTextStyle}" Margin="0,0,0,12" />

                        <TextBlock Text="Modifikator" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding SkillModifierText, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalAlignment="Left" Margin="0,0,0,8" />

                        <CheckBox Content="Kräuterkundeset (Vorteil)" IsChecked="{Binding UseHerbalismKit}" Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="🎲 Sammeln" Command="{Binding HarvestCommand}" FontWeight="SemiBold" />
                            <Button Content="Zurücksetzen" Command="{Binding ClearCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding RollSummary}"
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               Margin="0,0,0,6"
                               Visibility="{Binding HasResult, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />

                    <TextBlock Grid.Row="2"
                               Text="{Binding ResultSummary}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"
                               Visibility="{Binding HasResult, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding Finds}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <!-- Die Karten bringen ihren eigenen Innenabstand mit, deshalb hier
                                 bewusst ohne das globale ListBoxItem-Padding. -->
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource HintTextStyle}">
                                            <Run Text="{Binding KindLabel, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding RarityLabel, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Effect}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
