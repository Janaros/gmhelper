<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- UseWindowsForms below adds a global "using System.Windows.Forms;" which collides with
         WPF types of the same name (Application, UserControl, ...). We only need the Forms
         Screen class (fully-qualified) for secondary-monitor detection, so drop the global using. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GMHelper.Core\GMHelper.Core.csproj" />
    <ProjectReference Include="..\GMHelper.Data\GMHelper.Data.csproj" />
    <ProjectReference Include="..\GMHelper.Services\GMHelper.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Syncfusion.PdfViewer.WPF" Version="34.1.31" />
    <PackageReference Include="Syncfusion.SfSkinManager.WPF" Version="34.1.31" />
    <PackageReference Include="Syncfusion.Themes.Windows11Light.WPF" Version="34.1.31" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

</Project>
