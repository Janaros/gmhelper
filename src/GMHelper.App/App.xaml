<Application x:Class="GMHelper.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GMHelper.App">
    <Application.Resources>
        <!-- Central color palette. Individual views should reference these brushes instead of
             hardcoding hex values, so the app reads as one consistent system rather than each
             view improvising its own near-identical shade of blue/gray. -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF3F87DA" />
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFD8E6F7" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FFEAF0F7" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFF5F5F5" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFF0F0F0" />
        <SolidColorBrush x:Key="AppBorderBrush" Color="#FFDDDDDD" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF666666" />

        <!-- Spacing scale. Views use these steps instead of improvising 2/4/6/8/10/12 each,
             which is what made the overall layout look restless:
             ViewMargin    = outer margin of a top-level view against the window edge
             SubViewMargin = same, for views nested inside a tab (the tab frame already insets them)
             GutterMargin  = gap between two side-by-side columns
             FieldMargin   = gap below an input field before the next one -->
        <Thickness x:Key="ViewMargin">16</Thickness>
        <Thickness x:Key="SubViewMargin">12</Thickness>
        <Thickness x:Key="GutterMargin">0,0,12,0</Thickness>
        <Thickness x:Key="FieldMargin">0,0,0,12</Thickness>

        <!-- Size/spacing defaults for the standard WPF controls. Deliberately implicit styles
             directly in Application.Resources (not in a merged dictionary): local entries win
             over theme dictionaries, so the spacing applies regardless of what the Syncfusion
             theme brings along. Only spacing/size properties are set here — no templates and no
             colors — so the actual look stays the theme's job. -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Square icon buttons (+, ✕, 🎲, ...): the generous default padding would push their
             single glyph out of the button. -->
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- The global Syncfusion Windows11Light theme (applied as the default style for all
             standard WPF controls in App.xaml.cs) vertically centers TextBox content, which is
             correct for single-line inputs but makes multi-line editors visually "jump" as their
             content grows/shrinks while typing, since the whole re-centered block shifts every
             keystroke. Force top alignment back for AcceptsReturn TextBoxes only. -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="AcceptsReturn" Value="True">
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBoxes inside table cells live in a fixed row height and should read as text, not
             as an input box — hence no border and tight padding. -->
        <Style x:Key="GridCellTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Recurring text roles, so views no longer set their own FontSize/Foreground/Margin per
             label and texts of the same kind look identical everywhere. -->
        <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFC42B1C" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Set-off block for inline edit areas ("Gebiet bearbeiten", "Zutat bearbeiten", ...). -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Application.Resources>
</Application>
