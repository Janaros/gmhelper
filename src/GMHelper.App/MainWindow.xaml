<Window x:Class="GMHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GMHelper.App"
        xmlns:vm="clr-namespace:GMHelper.App.ViewModels"
        xmlns:views="clr-namespace:GMHelper.App.Views"
        mc:Ignorable="d"
        Title="GMHelper" Height="600" Width="900">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:CampaignListViewModel}">
            <views:CampaignListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CampaignDetailViewModel}">
            <views:CampaignDetailView />
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
