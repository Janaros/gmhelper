<Window x:Class="GMHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GMHelper.App"
        xmlns:vm="clr-namespace:GMHelper.App.ViewModels"
        xmlns:views="clr-namespace:GMHelper.App.Views"
        mc:Ignorable="d"
        Title="GMHelper" Height="600" Width="960"
        Icon="/Assets/GMHelper.ico">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:CampaignListViewModel}">
            <views:CampaignListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CampaignDetailViewModel}">
            <views:CampaignDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonsterDatabaseViewModel}">
            <views:MonsterDatabaseView />
        </DataTemplate>

        <Style x:Key="NavRailItemStyle" TargetType="ToggleButton">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Button DockPanel.Dock="Bottom"
                        Content="ⓘ Info"
                        HorizontalAlignment="Right"
                        Margin="0,0,12,10"
                        Padding="4,2"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Gray"
                        FontSize="11"
                        Cursor="Hand"
                        Click="InfoButton_Click" />

                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="GMHelper" FontSize="18" FontWeight="Bold" Margin="16,0,0,20" />

                    <ToggleButton Content="📁 Kampagnen"
                                  Style="{StaticResource NavRailItemStyle}"
                                  IsChecked="{Binding IsCampaignsSection, Mode=OneWay}"
                                  Command="{Binding NavigateToCampaignsCommand}" />

                    <ToggleButton Content="🐉 Monster-Datenbank"
                                  Style="{StaticResource NavRailItemStyle}"
                                  IsChecked="{Binding IsMonsterDatabaseSection, Mode=OneWay}"
                                  Command="{Binding NavigateToMonsterDatabaseCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
