<?xml version="1.0" encoding="utf-8"?>
<!--
ClickOnce publish profile for GMHelper.App. Must be built with the full-framework MSBuild
(e.g. from a Visual Studio install) via scripts/Publish-ClickOnce.ps1 - the .NET SDK's
cross-platform `dotnet publish` does not support the ClickOnce manifest-generation tasks
(MSB4803: GenerateTrustInfo).

ApplicationVersion's first three segments intentionally mirror the assembly <Version> in
GMHelper.App.csproj (bumped on every shipped change per project convention) so a single
version bump drives both the About dialog and ClickOnce's update check. The script passes
ApplicationVersion=$Version.0 at publish time; the value below is only a placeholder used
when this profile is published from the Visual Studio IDE instead of the script.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <InstallUrl>https://janaros.github.io/gmhelper/</InstallUrl>
    <Install>true</Install>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>1.0.0.0</ApplicationVersion>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <SignManifests>false</SignManifests>
    <GenerateManifests>true</GenerateManifests>
    <TargetZone>Internet</TargetZone>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <ProductName>GMHelper</ProductName>
    <PublisherName>Markus Klatte-Schür</PublisherName>
  </PropertyGroup>
</Project>
