<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GMHelper.Core\GMHelper.Core.csproj" />
    <ProjectReference Include="..\GMHelper.Data\GMHelper.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <!-- Windows-flavored TFM required below: Syncfusion.Pdf.Wpf only ships net8.0-windows7.0+
         assets (no plain net8.0 target), needed by PdfTocGeneratorService for the
         PdfLoadedDocument document-object-model (bookmark read/write), distinct from the
         interactive Syncfusion.PdfViewer.WPF control used in GMHelper.App. -->
    <PackageReference Include="Syncfusion.Pdf.Wpf" Version="34.1.31" />
    <!-- Syncfusion.Pdf.Wpf needs System.Drawing.Common at runtime but doesn't bring it in on its
         own; GMHelper.App gets it implicitly via UseWindowsForms, but this library (and anything
         hosting it standalone, e.g. the integration test runner) needs it explicit. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.4" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
